/* CN470-510 - channels 0-7 (470.3 - 471.7 MHz)
 * NEEDS A 470 MHz SX1301 BOARD (radios SX1255). The usual 868/915 MHz boards (SX1257) cannot
 * receive here. rssi_offset -176 is the usual value for SX1255 boards: calibrate yours.
 * radio_0 = 470.6 MHz -> 470.3/470.5/470.7/470.9 ; radio_1 = 471.4 MHz -> 471.1/471.3/471.5/471.7
 */
{
    "SX1301_conf": {
        "lorawan_public": true,
        "clksrc": 1, /* radio_1 provides clock to concentrator (Radioenge/RAK831/RAK2245/iC880A/RHF0M301) */
        "antenna_gain": 0, /* antenna gain, in dBi */
        "lbt_cfg": {
            "enable": false /* LBT needs the Semtech FPGA + SX127x (reference design only) */
        },
        "radio_0": {
            "enable": true,
            "type": "SX1255",
            "freq": 470600000,
            "rssi_offset": -176.0,
            "tx_enable": true,
            "tx_notch_freq": 129000, /* [126..250] kHz, used only with the FPGA */
            "tx_freq_min": 470000000,
            "tx_freq_max": 510000000
        },
        "radio_1": {
            "enable": true,
            "type": "SX1255",
            "freq": 471400000,
            "rssi_offset": -176.0,
            "tx_enable": false
        },
        "chan_multiSF_0": {"enable": true, "radio": 0, "if": -300000},  /* 470.3 MHz */
        "chan_multiSF_1": {"enable": true, "radio": 0, "if": -100000},  /* 470.5 MHz */
        "chan_multiSF_2": {"enable": true, "radio": 0, "if":  100000},  /* 470.7 MHz */
        "chan_multiSF_3": {"enable": true, "radio": 0, "if":  300000},  /* 470.9 MHz */
        "chan_multiSF_4": {"enable": true, "radio": 1, "if": -300000},  /* 471.1 MHz */
        "chan_multiSF_5": {"enable": true, "radio": 1, "if": -100000},  /* 471.3 MHz */
        "chan_multiSF_6": {"enable": true, "radio": 1, "if":  100000},  /* 471.5 MHz */
        "chan_multiSF_7": {"enable": true, "radio": 1, "if":  300000},  /* 471.7 MHz */
        "chan_Lora_std":  {"enable": false, "radio": 1, "if": -200000, "bandwidth": 250000, "spread_factor": 7},
        "chan_FSK":       {"enable": false, "radio": 1, "if":  300000, "bandwidth": 125000, "datarate": 50000},
        /* TX gain table: Semtech SX1301 reference design (PCB_E286 / iC880A / RAK831 / RAK2245),
         * the same as global_conf.json of Lora-net/packet_forwarder v4.0.1.
         * rf_power is the power at the antenna connector for a board WITH the PA. */
        "tx_lut_0":  {"pa_gain": 0, "mix_gain":  8, "rf_power":  -6, "dig_gain": 0},
        "tx_lut_1":  {"pa_gain": 0, "mix_gain": 10, "rf_power":  -3, "dig_gain": 0},
        "tx_lut_2":  {"pa_gain": 0, "mix_gain": 12, "rf_power":   0, "dig_gain": 0},
        "tx_lut_3":  {"pa_gain": 1, "mix_gain":  8, "rf_power":   3, "dig_gain": 0},
        "tx_lut_4":  {"pa_gain": 1, "mix_gain": 10, "rf_power":   6, "dig_gain": 0},
        "tx_lut_5":  {"pa_gain": 1, "mix_gain": 12, "rf_power":  10, "dig_gain": 0},
        "tx_lut_6":  {"pa_gain": 1, "mix_gain": 13, "rf_power":  11, "dig_gain": 0},
        "tx_lut_7":  {"pa_gain": 2, "mix_gain":  9, "rf_power":  12, "dig_gain": 0},
        "tx_lut_8":  {"pa_gain": 1, "mix_gain": 15, "rf_power":  13, "dig_gain": 0},
        "tx_lut_9":  {"pa_gain": 2, "mix_gain": 10, "rf_power":  14, "dig_gain": 0},
        "tx_lut_10": {"pa_gain": 2, "mix_gain": 11, "rf_power":  16, "dig_gain": 0},
        "tx_lut_11": {"pa_gain": 3, "mix_gain":  9, "rf_power":  20, "dig_gain": 0},
        "tx_lut_12": {"pa_gain": 3, "mix_gain": 10, "rf_power":  23, "dig_gain": 0},
        "tx_lut_13": {"pa_gain": 3, "mix_gain": 11, "rf_power":  25, "dig_gain": 0},
        "tx_lut_14": {"pa_gain": 3, "mix_gain": 12, "rf_power":  26, "dig_gain": 0},
        "tx_lut_15": {"pa_gain": 3, "mix_gain": 14, "rf_power":  27, "dig_gain": 0}
    },

    "gateway_conf": {
        "gateway_ID": "AA555A00000021FB",
        /* change with default server address/ports */
        "server_address": "192.168.1.202",
        "serv_port_up": 1680,
        "serv_port_down": 1680,
        /* adjust the following parameters for your network */
        "keepalive_interval": 10,
        "stat_interval": 30,
        "push_timeout_ms": 100,
        /* forward only valid packets */
        "forward_crc_valid": true,
        "forward_crc_error": false,
        "forward_crc_disabled": false,
        /* GPS configuration */
        "gps_tty_path": "/dev/ttyS0", /* ignored on the ESP32: UART pins in main/CMakeLists.txt */
        /* GPS reference coordinates */
        "ref_latitude": 0.0,
        "ref_longitude": 0.0,
        "ref_altitude": 0,
        /* Beaconing parameters */
        "beacon_period": 0,
        "beacon_freq_hz": 508300000,
        "beacon_datarate": 9,
        "beacon_bw_hz": 125000,
        "beacon_power": 14,
        "beacon_infodesc": 0
    }
}
