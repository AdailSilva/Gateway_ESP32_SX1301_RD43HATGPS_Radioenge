/* AU915-928 (LoRaWAN RP002) - sub-band 1: uplink channels 8-15 (125 kHz) + channel 65 (500 kHz)
 * radio_0 = 917.2 MHz -> ch 8..11 (IF -400/-200/0/+200 kHz) + ch 65 (IF +300 kHz)
 * radio_1 = 917.9 MHz -> ch 12..15 (IF -300/-100/+100/+300 kHz)
 * Downlink (RX1/RX2): 923.3 - 927.5 MHz, 600 kHz step, 500 kHz BW (TX via radio_0, 915-928 MHz)
 * SX1301 version: radios SX1257, clksrc 1, TX gain table tx_lut_0..15
 */
{
    "SX1301_conf": {
        "lorawan_public": true,
        "clksrc": 1, /* radio_1 provides clock to concentrator (Radioenge/RAK831/RAK2245/iC880A/RHF0M301) */
        "antenna_gain": 0, /* antenna gain, in dBi */
        "lbt_cfg": {
            "enable": false /* LBT needs the Semtech FPGA + SX127x (reference design only) */
        },
        "radio_0": {
            "enable": true,
            "type": "SX1257",
            "freq": 917200000,
            "rssi_offset": -166.0,
            "tx_enable": true,
            "tx_notch_freq": 129000, /* [126..250] kHz, used only with the FPGA */
            "tx_freq_min": 915000000,
            "tx_freq_max": 928000000
        },
        "radio_1": {
            "enable": true,
            "type": "SX1257",
            "freq": 917900000,
            "rssi_offset": -166.0,
            "tx_enable": false
        },
        "chan_multiSF_0": {"enable": true, "radio": 0, "if": -400000},  /* AU915 ch  8 - Freq : 916.8 MHz (125 kHz) */
        "chan_multiSF_1": {"enable": true, "radio": 0, "if": -200000},  /* AU915 ch  9 - Freq : 917.0 MHz (125 kHz) */
        "chan_multiSF_2": {"enable": true, "radio": 0, "if":  0},  /* AU915 ch 10 - Freq : 917.2 MHz (125 kHz) */
        "chan_multiSF_3": {"enable": true, "radio": 0, "if":  200000},  /* AU915 ch 11 - Freq : 917.4 MHz (125 kHz) */
        "chan_multiSF_4": {"enable": true, "radio": 1, "if": -300000},  /* AU915 ch 12 - Freq : 917.6 MHz (125 kHz) */
        "chan_multiSF_5": {"enable": true, "radio": 1, "if": -100000},  /* AU915 ch 13 - Freq : 917.8 MHz (125 kHz) */
        "chan_multiSF_6": {"enable": true, "radio": 1, "if":  100000},  /* AU915 ch 14 - Freq : 918.0 MHz (125 kHz) */
        "chan_multiSF_7": {"enable": true, "radio": 1, "if":  300000},  /* AU915 ch 15 - Freq : 918.2 MHz (125 kHz) */
        "chan_Lora_std":  {"enable": true, "radio": 0, "if":  300000, "bandwidth": 500000, "spread_factor": 8},  /* AU915 ch 65 - Freq : 917.5 MHz (500 kHz, DR6 SF8BW500) */
        "chan_FSK":       {"enable": false, "radio": 1, "if":  300000, "bandwidth": 125000, "datarate": 50000},  /* FSK not used in AU915 */
        /* TX gain table: Semtech SX1301 reference design (PCB_E286 / iC880A / RAK831 / RAK2245),
         * the same as global_conf.json of Lora-net/packet_forwarder v4.0.1.
         * rf_power is the power at the antenna connector for a board WITH the PA.
         * Radioenge LoRaWAN Gateway (max +27 dBm): compare with global_conf_AU915.json of its SD card image. */
        "tx_lut_0":  {"pa_gain": 0, "mix_gain":  8, "rf_power":  -6, "dig_gain": 0},
        "tx_lut_1":  {"pa_gain": 0, "mix_gain": 10, "rf_power":  -3, "dig_gain": 0},
        "tx_lut_2":  {"pa_gain": 0, "mix_gain": 12, "rf_power":   0, "dig_gain": 0},
        "tx_lut_3":  {"pa_gain": 1, "mix_gain":  8, "rf_power":   3, "dig_gain": 0},
        "tx_lut_4":  {"pa_gain": 1, "mix_gain": 10, "rf_power":   6, "dig_gain": 0},
        "tx_lut_5":  {"pa_gain": 1, "mix_gain": 12, "rf_power":  10, "dig_gain": 0},
        "tx_lut_6":  {"pa_gain": 1, "mix_gain": 13, "rf_power":  11, "dig_gain": 0},
        "tx_lut_7":  {"pa_gain": 2, "mix_gain":  9, "rf_power":  12, "dig_gain": 0},
        "tx_lut_8":  {"pa_gain": 1, "mix_gain": 15, "rf_power":  13, "dig_gain": 0},
        "tx_lut_9":  {"pa_gain": 2, "mix_gain": 10, "rf_power":  14, "dig_gain": 0},
        "tx_lut_10": {"pa_gain": 2, "mix_gain": 11, "rf_power":  16, "dig_gain": 0},
        "tx_lut_11": {"pa_gain": 3, "mix_gain":  9, "rf_power":  20, "dig_gain": 0},
        "tx_lut_12": {"pa_gain": 3, "mix_gain": 10, "rf_power":  23, "dig_gain": 0},
        "tx_lut_13": {"pa_gain": 3, "mix_gain": 11, "rf_power":  25, "dig_gain": 0},
        "tx_lut_14": {"pa_gain": 3, "mix_gain": 12, "rf_power":  26, "dig_gain": 0},
        "tx_lut_15": {"pa_gain": 3, "mix_gain": 14, "rf_power":  27, "dig_gain": 0}
    },

    "gateway_conf": {
        "gateway_ID": "AA555A0000000000",
        /* change with default server address/ports */
        "server_address": "localhost",
        "serv_port_up": 1730,
        "serv_port_down": 1730,
        /* adjust the following parameters for your network */
        "keepalive_interval": 10,
        "stat_interval": 30,
        "push_timeout_ms": 100,
        /* forward only valid packets */
        "forward_crc_valid": true,
        "forward_crc_error": false,
        "forward_crc_disabled": false,
        /* GPS configuration */
        "gps_tty_path": "/dev/ttyS0", /* ignored on the ESP32: UART pins in main/CMakeLists.txt */
        /* GPS reference coordinates */
        "ref_latitude": 0.0,
        "ref_longitude": 0.0,
        "ref_altitude": 0,
        /* Beaconing parameters */
        "beacon_period": 0, /* disable class B beacon */
        "beacon_freq_hz": 923300000, /* AU915: 923.3 MHz + n*600 kHz */
        "beacon_freq_nb": 8,
        "beacon_freq_step": 600000,
        "beacon_datarate": 12, /* SF12 BW500 (DR8) */
        "beacon_bw_hz": 500000,
        "beacon_power": 14,
        "beacon_infodesc": 0
    }
}
